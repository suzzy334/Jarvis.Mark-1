{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://sentinelkey-backend.onrender.com/api/$1"
    },
    {
      "src": "^/$",
      "dest": "/frontend/login.html"
    },
    {
      "src": "^/login$",
      "dest": "/frontend/login.html"
    },
    {
      "src": "^/admin$",
      "dest": "/frontend/admin_dashboard.html"
    },
    {
      "src": "^/student$",
      "dest": "/frontend/student_dashboard.html"
    },
    {
      "src": "^/faculty$",
      "dest": "/frontend/faculty_dashboard.html"
    },
    {
      "src": "^/challenge$",
      "dest": "/frontend/challenge.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    }
  ]
}